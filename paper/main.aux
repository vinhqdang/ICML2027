\newlabel{tab:diag}{{1}{6}{\textbf {Consistency diagnostics on molecular targets.} $|z|$: larger of the two $z$-scores of the test of \cref {prop:diag}(i) ($N=20\,000$ reference pairs per $\sigma _t$; bold: $|z|>3$). An unbiased target must give $|z|$ of order one. $\Delta \tilde L$: held-out normalized denoising loss of the oracle-trained iDEM model minus that of the AEM model (mean $\pm $ std over 3 seeds; in parentheses, the number of seeds with $\Delta \tilde L>0$). By \cref {prop:diag}(ii), $\Delta \tilde L>0$ means that AEM learned the more accurate score}{table.caption.1}{}}
\newlabel{tab:diag@cref}{{[table][1][]1}{[1][5][]6}}
\newlabel{sec:exp-oracle}{{4.2}{6}{}{subsection.4.2}{}}
\newlabel{sec:exp-oracle@cref}{{[subsection][2][4]4.2}{[1][5][]6}}
\newlabel{tab:oracle}{{2}{6}{\textbf {Oracle buffer} (fixed exact samples, no sampler loop; $K=100$; mean $\pm $ std over 3 seeds, except $K{=}1000$: one seed). Relative error $\mathbb {E}\|s_\theta -\nabla \log p_t\|^2/\mathbb {E}\|\nabla \log p_t\|^2$ of the learned score}{table.caption.2}{}}
\newlabel{tab:oracle@cref}{{[table][2][]2}{[1][6][]6}}
\newlabel{sec:exp-training}{{4.3}{6}{}{subsection.4.3}{}}
\newlabel{sec:exp-training@cref}{{[subsection][3][4]4.3}{[1][6][]6}}
\newlabel{fig:estimator}{{1}{7}{\textbf {Estimator study on GMM-40.} Relative MSE (top) and debiased relative squared bias (bottom) of the noised-score target against $\sigma _t$, for iDEM (dashed) and AEM (solid) with TSI or DSI test functions. Columns use exact anchors (left), anchors from a tempered target (centre) and anchors from a target missing half of its modes (right). With exact anchors AEM is unbiased for every $K$, including $K=0$. iDEM's bias grows by orders of magnitude with $\sigma _t$}{figure.caption.3}{}}
\newlabel{fig:estimator@cref}{{[figure][1][]1}{[1][6][]7}}
\newlabel{sec:exp-ablation}{{4.4}{7}{}{subsection.4.4}{}}
\newlabel{sec:exp-ablation@cref}{{[subsection][4][4]4.4}{[1][7][]7}}
\newlabel{sec:conclusion}{{5}{7}{}{section.5}{}}
