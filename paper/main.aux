\newlabel{fig:curves}{{2}{8}{\textbf {Energy $\mathcal {W}_1$ during training} (mean and min--max over 3 seeds; log scale). The dotted line marks the switch from exploration to anchoring in the explore$\to $anchor runs. Before it, those runs coincide with iDEM. On LJ-13 the untrimmed metric is dominated by rare very-high-energy samples}{figure.caption.4}{}}
\newlabel{fig:curves@cref}{{[figure][2][]2}{[1][7][]8}}
\newlabel{tab:main}{{3}{8}{\textbf {Sampler quality on the synthetic targets} (mean $\pm $ sample std over 3 seeds; $80$ outer iterations; lower is better, except that the variance ratio should be $1$). All methods use the same budget and target function. The variance ratio measures within-mode spread (truth $=1$). Bold marks the best mean in each column (for the variance ratio, the closest to $1$). MMD is the unbiased estimate of MMD$^2$. Mode TV is the total-variation distance between empirical and true mode occupancies (GMM-10: the 10 components; MW-32: the 16 sign patterns of the first four double-well coordinates)}{table.caption.5}{}}
\newlabel{tab:main@cref}{{[table][3][]3}{[1][7][]8}}
\newlabel{tab:mol}{{4}{8}{\textbf {Molecular targets} (mean $\pm $ sample std over 3 seeds; $40$ outer iterations for DW-4, $30$ for LJ-13; EGNN score network). $\mathcal {E}$-$\mathcal {W}_1$: energy-histogram distance; tr: after removing model samples whose energy exceeds the $99.9\%$ quantile of the reference energies (their fraction is in the last column; the reference itself has $0.1\%$); $d$-$\mathcal {W}_1$: $\mathcal {W}_1$ between pooled interatomic distances. Bold marks the best mean per column}{table.caption.6}{}}
\newlabel{tab:mol@cref}{{[table][4][]4}{[1][7][]8}}
