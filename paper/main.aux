\bibcite{akhound2024iterated}{{1}{2024}{{Akhound-Sadegh et~al.}}{{Akhound-Sadegh, Rector-Brooks, Bose, Mittal, Lemos, Liu, Sendera, Ravanbakhsh, Gidel, Bengio, Malkin, and Tong}}}
\newlabel{fig:estimator}{{1}{6}{\textbf {Estimator study on GMM-40.} Relative MSE (top) and debiased relative squared bias (bottom) of the noised-score target against $\sigma _t$, for iDEM (dashed) and AEM (solid) with TSI or DSI test functions. Columns use exact anchors (left), anchors from a tempered target (centre) and anchors from a target missing half of its modes (right). With exact anchors AEM is unbiased for every $K$, including $K=0$. iDEM's bias grows by orders of magnitude with $\sigma _t$}{figure.caption.1}{}}
\newlabel{fig:estimator@cref}{{[figure][1][]1}{[1][5][]6}}
\newlabel{fig:curves}{{2}{6}{\textbf {Energy $\mathcal {W}_1$ during training} (mean and min--max over 3 seeds). The dotted line marks the switch from exploration to anchoring in the explore$\to $anchor runs. Before it, those runs coincide with iDEM}{figure.caption.2}{}}
\newlabel{fig:curves@cref}{{[figure][2][]2}{[1][5][]6}}
\newlabel{fig:marginals}{{3}{6}{\textbf {MW-32 marginals} (samples pooled over 3 seeds) against exact samples (grey). iDEM's fixed-point bias widens the Gaussian coordinates, smears mass between the wells and shifts the energy distribution. AEM removes these distortions}{figure.caption.3}{}}
\newlabel{fig:marginals@cref}{{[figure][3][]3}{[1][5][]6}}
